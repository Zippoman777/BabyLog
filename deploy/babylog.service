[Unit]
Description=BabyLog (Flask/gunicorn)
After=network.target

[Service]
User=babylog
Group=babylog
WorkingDirectory=/opt/babylog
EnvironmentFile=/opt/babylog/babylog.env
ExecStart=/opt/babylog/.venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:8000 app:app
Restart=always
# light sandboxing
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
