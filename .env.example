# Copy to babylog.env (or .env for Docker) and fill in.
# Login password — generate with:  python set_password.py babylog.env
BABYLOG_PASSWORD_HASH=
# Random string that signs the session cookie (logins survive restarts):
#   python -c "import secrets; print(secrets.token_hex(32))"
BABYLOG_SECRET=
# 1 once the site is served over HTTPS (Secure cookies + HSTS)
BABYLOG_SECURE_COOKIES=0
# Optional geo-block, e.g. NL,DE (needs Cloudflare's CF-IPCountry or a GeoIP DB)
BABYLOG_ALLOWED_COUNTRIES=
